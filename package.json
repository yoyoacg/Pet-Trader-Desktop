{
  "name": "my-life-desktop",
  "version": "0.1.0",
  "description": "本地养宠，共同交易的虚拟废话交易所",
  "author": "my-life contributors",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "fetch-vpet": "node scripts/download-vpet.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@pixi/unsafe-eval": "6.5.10",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "org.mylife.exchange",
    "productName": "废话交易所",
    "directories": { "output": "release" },
    "files": ["dist/**", "src/main/**", "src/preload/**", "assets/**", "!assets/pets/**/previews/**", "!assets/pets/**/dsh-*.json", "vendor/**", "package.json"],
    "electronLanguages": ["zh-CN", "en-US"],
    "compression": "maximum",
    "win": { "target": ["nsis", "zip"], "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
